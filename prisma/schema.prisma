generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum TransactionType {
  AIRTIME_PURCHASE
  DATA_PURCHASE
  AIRTIME_CONVERSION
  WALLET_FUNDING
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum ConversionStatus {
  PENDING
  VERIFYING
  COMPLETED
  FAILED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Network {
  MTN
  AIRTEL
  GLO
  NINE_MOBILE
}

model User {
  id               String   @id @default(uuid())
  fullName         String
  email            String   @unique
  phone            String   @unique
  password         String
  role             Role     @default(CUSTOMER)
  isVerified       Boolean  @default(false)
  isActive         Boolean  @default(true)
  transactionPin   String?
  refreshToken     String?
  virtualAccountNumber String?
  virtualAccountBank   String?
  virtualAccountRef    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wallet             Wallet?
  transactions       Transaction[]
  airtimeConversions AirtimeConversion[]
  withdrawals        Withdrawal[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(PENDING)
  reference   String            @unique
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model AirtimeConversion {
  id             String           @id @default(uuid())
  userId         String
  network        Network
  airtimeAmount  Float
  conversionRate Float
  cashValue      Float
  status         ConversionStatus @default(PENDING)
  transferNumber String?
  verifiedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("airtime_conversions")
}

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  amount        Float
  bankName      String
  accountNumber String
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  reference     String           @unique
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

model AirtimePurchase {
  id        String            @id @default(uuid())
  userId    String
  network   Network
  phone     String
  amount    Float
  status    TransactionStatus @default(PENDING)
  reference String            @unique
  vtpassRef String?
  createdAt DateTime          @default(now())

  @@map("airtime_purchases")
}

model DataPurchase {
  id        String            @id @default(uuid())
  userId    String
  network   Network
  phone     String
  planCode  String
  planName  String
  amount    Float
  status    TransactionStatus @default(PENDING)
  reference String            @unique
  vtpassRef String?
  createdAt DateTime          @default(now())

  @@map("data_purchases")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ConversionRate {
  id        String   @id @default(uuid())
  network   Network  @unique
  rate      Float
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("conversion_rates")
}